---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	ogImage?: string; // Allow custom OG image URL
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage, ogImage } = Astro.props;
const socialImage = ogImage ? new URL(ogImage, Astro.site) : new URL(image.src, Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/logo/AIceberg_mind_logo_color.svg" />
<link rel="apple-touch-icon" href="/logo/AIceberg_mind_logo_color.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AIcebergMind",
  "description": "AIceberg Mind - AI tools for deep thinking & discovery. Interactive AI tools for cognitive development, creative learning, and thoughtful exploration.",
  "url": "https://aicebergmind.com",
  "sameAs": [],
  "foundingDate": "2025",
  "industry": "Digital Content & Learning Experiences",
  "keywords": ["AI tools", "deep thinking", "discovery", "cognitive development", "interactive learning", "creative exploration", "mindful design"],
  "mainEntity": {
    "@type": "WebSite",
    "name": "AIceberg Mind",
    "description": "AI tools for deep thinking & discovery. Interactive tools for cognitive development and creative learning.",
    "url": "https://aicebergmind.com"
  }
}
</script>

<!-- Design Tokens - MUST be first -->
<link rel="stylesheet" href="/css/tokens/design-tokens.css">

<!-- Base styles -->
<link rel="stylesheet" href="/css/base.css">

<!-- Editorial Caption Animation System -->
<link rel="stylesheet" href="/css/variables/editorial-astro.css">

<!-- Interactive Components -->
<link rel="stylesheet" href="/css/components/interactive-components.css">

<!-- Layout and Sections CSS -->
<link rel="stylesheet" href="/css/global-styles.css">
<link rel="stylesheet" href="/css/hero-section.css">
<link rel="stylesheet" href="/css/utilities.css">

<!-- Responsive CSS -->
<link rel="stylesheet" href="/css/responsive/mobile.css">

<!-- Component specific CSS -->
<link rel="stylesheet" href="/css/components/hamburger-menu.css">
<link rel="stylesheet" href="/css/core-pillars.css">

<!-- Universal Sticky Titles JavaScript -->
<script src="/js/sticky-titles-simple.js" defer></script>

<!-- Letter Explosion Animation -->
<script src="/js/letter-explosion.js" defer></script>

<!-- Scroll Progress Bar -->
<script src="/js/components/scroll-progress.js" defer></script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content="AI, artificial intelligence, cognitive development, interactive learning, educational tools, deep thinking, creative exploration, child development, family education" />
<meta name="author" content="AIceberg Mind" />
<meta name="robots" content="index, follow" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:site_name" content="AIceberg Mind" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />
